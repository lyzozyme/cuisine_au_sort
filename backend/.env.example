# Copier en .env et adapter
# 127.0.0.1 plutôt que localhost : PostgreSQL n'est publié qu'en IPv4 (docker-compose.yml) ;
# avec localhost, chaque connexion tente d'abord ::1 et peut attendre le connect_timeout.
APP_NAME=CuisineAuSort
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://cuisineausort:cuisineausort@127.0.0.1:5432/cuisineausort
TEST_DATABASE_URL=postgresql+psycopg://cuisineausort:cuisineausort@127.0.0.1:5432/cuisineausort_test
DATABASE_CONNECT_TIMEOUT=5
# Liste JSON des origines autorisées (frontend)
CORS_ORIGINS=["http://localhost:5173"]
# Utilisateur unique créé par le seed (en attendant une vraie authentification)
DEFAULT_USER_EMAIL=default@cuisineausort.local
DEFAULT_USER_DISPLAY_NAME=Utilisateur par défaut
